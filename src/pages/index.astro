---
// Homepage — a landing page, not an index of everything. Bio, a quiet
// directory into the branch pages, and personal socials. Content that used to
// live here now sits on its branch:
//   Writing → /writing · Cooking + restaurants → /cooking
//   Snapshots → /travel-log · Currently listening → /concert-log
// Stats tiles retired with the sheet fetch they depended on.
import Base from "../layouts/Base.astro";

const branches = [
  { label: "Work",    href: "/work",        sub: "What I do, and what I'm good at" },
  { label: "Cooking", href: "/cooking",     sub: "Fife Spice, recipes, and where I eat in Austin" },
  { label: "Writing", href: "/writing",     sub: "Essays, mostly about people and Texas" },
  { label: "Travel",  href: "/travel-log",  sub: "Every place I've been, mapped" },
  { label: "Live",    href: "/concert-log", sub: "Every concert, stand-up set, and football game" },
];
---

<Base title="Julian John Fife" back={false}>
  <div class="header">
    <img src="/profile.jpg" alt="Julian Fife" class="profile-photo">
    <div>
      <h1>Julian John Fife</h1>
      <p class="tagline">Writer, cook, and web builder in Austin, TX</p>
    </div>
  </div>

  <div class="section bio-section">
    <p class="section-label">Bio</p>
    <ul class="list">
      <li><span>Currently live in Austin, TX, with my wife, <span class="hover-pic">Amani<span class="hover-tooltip"><img src="/amani.jpeg" alt="Amani"></span></span>, and our two cats, <span class="hover-pic">Teddy<span class="hover-tooltip"><img src="/teddy.jpeg" alt="Teddy"></span></span> &amp; <span class="hover-pic">Bear<span class="hover-tooltip"><img src="/bear.jpeg" alt="Bear"></span></span></span></li>
      <li><span>Born &amp; raised in Denver, CO <img src="/co_flag.svg.png" alt="Colorado flag" class="inline-flag"></span></li>
      <li><span>MBA &middot; UT Austin | BA, Economics &middot; UT Austin <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/8d/Texas_Longhorns_logo.svg/120px-Texas_Longhorns_logo.svg.png" alt="Longhorns logo" class="longhorns-logo"></span></li>
      <li><span>Love to cook, travel, build web tools, and go to football games <img src="https://upload.wikimedia.org/wikipedia/en/thumb/4/44/Denver_Broncos_logo.svg/120px-Denver_Broncos_logo.svg.png" alt="Broncos logo" class="longhorns-logo"></span></li>
    </ul>
  </div>

  <div class="section">
    <p class="section-label">To see my</p>
    <ul class="dir">
      {branches.map(b => (
        <li>
          <a href={b.href}>
            <span class="dir-label">{b.label}</span>
            <span class="dir-sub">{b.sub}</span>
            <span class="dir-arrow">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="section">
    <p class="section-label">Connect</p>
    <div class="social-icons">
      <a href="https://x.com/julianfife" target="_blank" rel="noopener noreferrer" title="X / Twitter">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="https://instagram.com/julianfife" target="_blank" rel="noopener noreferrer" title="Instagram @julianfife">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/julian-fife/" target="_blank" rel="noopener noreferrer" title="LinkedIn">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
    </div>
  </div>

  <style>
    .bio-section { margin-top: 44px; margin-bottom: 52px; }

    /* Directory — the quiet hub. Type carries it; no card chrome. */
    .dir { list-style: none; }
    .dir li { border-bottom: 1px solid var(--stone-200); }
    .dir li:last-child { border-bottom: none; }
    .dir a {
      display: grid; grid-template-columns: 1fr auto; align-items: baseline;
      column-gap: 20px; padding: 17px 2px;
      transition: padding-left 0.16s var(--ease);
    }
    .dir a:hover { text-decoration: none; padding-left: 8px; }
    .dir-label {
      font-family: var(--font-display); font-weight: 700; font-size: 1.3rem;
      letter-spacing: -0.025em; color: var(--ink); transition: color 0.16s;
    }
    .dir a:hover .dir-label { color: var(--orange); }
    .dir-sub {
      grid-column: 1; font-size: 0.86rem; color: var(--stone-600);
      margin-top: 3px; line-height: 1.5;
    }
    .dir-arrow {
      grid-row: 1 / span 2; grid-column: 2; align-self: center;
      font-size: 1.15rem; color: var(--stone-300); transition: color 0.16s, transform 0.16s var(--ease);
    }
    .dir a:hover .dir-arrow { color: var(--orange); transform: translateX(4px); }

    @media (max-width: 560px) {
      .dir-label { font-size: 1.15rem; }
    }
  </style>
</Base>
