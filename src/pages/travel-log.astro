---
// Faithful port of the original travel-log.html. CSS and the app script are
// is:inline so Astro emits them verbatim; only relative asset paths were rewritten
// to root-absolute (/people for friend photos, /trips for trip galleries) so they
// resolve from the /travel-log/ route. Still fetches the Google Sheet client-side.

// Snapshots strip (moved here from the homepage when it became a landing page).
// Every loose image in public/trips/ — read at build time, so dropping a photo
// into the folder makes it appear on the next build. Per-trip galleries below
// are separate: those come from the sheet's photo_folder/photos columns.
import { readdirSync } from "node:fs";
import { fileURLToPath } from "node:url";
let tripPhotos = [];
try {
  const dir = fileURLToPath(new URL("../../public/trips", import.meta.url));
  tripPhotos = readdirSync(dir)
    .filter(f => /\.(jpe?g|png|webp)$/i.test(f))
    .sort()
    .map(f => "/trips/" + f);
} catch { /* folder missing — strip just won't render */ }
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Places: A Travel Log</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%231E1C19'/%3E%3Ctext x='21' y='45' font-family='Archivo,Helvetica,Arial,sans-serif' font-weight='800' font-size='34' fill='%23F6F4EF' text-anchor='middle'%3EJ%3C/text%3E%3Ctext x='43' y='45' font-family='Archivo,Helvetica,Arial,sans-serif' font-weight='800' font-size='34' fill='%23BF5700' text-anchor='middle'%3EF%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<style is:inline>
:root{
  /* "The Operator" — see brand-guide-standalone.html. Same tokens as
     src/layouts/Base.astro; duplicated here because this page is a standalone
     is:inline port and does not use that layout. */
  --orange:#BF5700; --orange-deep:#9A4500; --orange-soft:#F6E3D2;
  --on-orange:#FFFFFF; --on-orange-dim:#F6D8C2;
  --stone-700:#43403A; --stone-600:#635E55; --stone-400:#9C968A;
  --stone-300:#C3BEB3; --stone-200:#E3E0D8; --stone-100:#EEEBE3;
  --paper:#F6F4EF; --white:#FFFFFF;
  --font-display:"Archivo","Helvetica Neue",Arial,sans-serif;
  --font-mono:"Space Mono","SFMono-Regular",ui-monospace,monospace;
  --font-editorial:"Newsreader",Georgia,"Times New Roman",serif;

  /* Categorical series ramp, fixed order — validated for CVD and for >=3:1
     contrast on the paper surface. Slot 1 is the brand signature. Assign by
     entity, never by rank, and never generate a hue for an extra category. */
  --s1:#BF5700; --s2:#009184; --s3:#6257C4; --s4:#A32D5E;

  /* Aliases keeping this port's original variable names working. */
  --bg:var(--paper); --bg2:var(--stone-100); --ink:#1E1C19;
  --muted:var(--stone-600); --line:var(--stone-200);
  --gold:var(--orange); --gold-soft:var(--orange-soft);
  --card:var(--white); --card-hi:var(--stone-100);
  --shadow-sm:0 1px 2px rgba(30,25,15,.06);
  --shadow-md:0 4px 14px -6px rgba(30,25,15,.14);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--stone-700);font-family:var(--font-display);-webkit-font-smoothing:antialiased;overflow-x:hidden;
  background-image:radial-gradient(1100px 520px at 82% -10%,rgba(191,87,0,.055),transparent 62%);}
.homelink{display:inline-flex;align-items:center;gap:8px;margin-top:30px;font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--stone-600);text-decoration:none;transition:color .16s,gap .16s}
.homelink:hover{color:var(--orange);gap:12px}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
.marquee{border-bottom:1px solid var(--line);overflow:hidden;white-space:nowrap;background:var(--stone-100)}
.marquee span{display:inline-block;padding:9px 0;font-family:var(--font-mono);font-size:11px;letter-spacing:.28em;color:var(--muted);animation:scroll 60s linear infinite}
.marquee b{color:var(--gold)}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.hero{padding:64px 0 30px;position:relative}
.kicker{font-family:var(--font-mono);font-size:12px;letter-spacing:.4em;color:var(--gold);text-transform:uppercase}
.hero h1{font-family:var(--font-display);font-weight:900;font-size:clamp(76px,17vw,190px);line-height:.84;letter-spacing:-.01em;text-transform:uppercase;margin:8px 0 0;
  color:var(--ink);}
.hero .sub{color:var(--muted);font-size:18px;max-width:48ch;margin-top:14px;line-height:1.4}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:46px}
.stat{background:var(--bg);padding:26px 18px;text-align:center}
.stat .n{font-family:var(--font-display);font-weight:800;font-size:clamp(34px,6vw,58px);line-height:1;color:var(--gold)}
.stat .l{font-family:var(--font-mono);font-size:10px;letter-spacing:.22em;color:var(--muted);text-transform:uppercase;margin-top:9px}
.controls{position:sticky;top:0;z-index:600;background:rgba(246,244,239,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding:14px 0;margin-top:2px}
.controls .row{display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.search{flex:1;min-width:200px;position:relative}
.search input{width:100%;background:var(--card);border:1px solid var(--line);color:var(--ink);font-family:var(--font-display);font-size:16px;padding:11px 36px 11px 38px;border-radius:2px;outline:none}
.search .clearq{position:absolute;right:7px;top:50%;transform:translateY(-50%);width:24px;height:24px;padding:0;border:none;background:transparent;color:var(--stone-400);font-family:var(--font-mono);font-size:16px;line-height:1;cursor:pointer;border-radius:50%;display:none;align-items:center;justify-content:center;transition:color .15s,background .15s}
.search .clearq.show{display:flex}
.search .clearq:hover{color:var(--orange);background:var(--stone-100)}
.search input:focus{border-color:var(--gold)}
.search::before{content:"⌕";position:absolute;left:12px;top:8px;font-size:19px;color:var(--muted)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;background:transparent;border:1px solid var(--line);color:var(--muted);padding:8px 13px;border-radius:2px;cursor:pointer;transition:.18s}
.chip:hover{color:var(--ink);border-color:var(--muted)}
.chip.on{background:var(--gold);border-color:var(--gold);color:var(--on-orange);font-weight:700}
.chip.dot::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:7px;vertical-align:middle;background:currentColor}
.tabs{display:flex;gap:0;border:1px solid var(--line);border-radius:2px;overflow:hidden}
.tab{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;background:transparent;border:none;color:var(--muted);padding:8px 14px;cursor:pointer;transition:.18s}
.tab:hover{color:var(--ink)} .tab.on{background:var(--gold);color:var(--on-orange);font-weight:700}
.countline{font-family:var(--font-mono);font-size:11px;color:var(--muted);letter-spacing:.1em;margin-top:10px}
.countline b{color:var(--gold)}
/* timeline */
.timeline{display:none;padding:14px 0 6px}
.timeline.show{display:block}
.year-block{padding:34px 0 6px}
.year-head{display:flex;align-items:baseline;gap:16px;margin-bottom:20px}
.year-head .y{font-family:var(--font-display);font-weight:900;font-size:clamp(40px,8vw,72px);line-height:.9;-webkit-text-stroke:1.5px var(--gold);color:transparent}
.year-head .bar{flex:1;height:1px;background:var(--line)}
.year-head .ct{font-family:var(--font-mono);font-size:11px;color:var(--muted);letter-spacing:.15em}
.trip-group{margin-bottom:18px;border:1px solid var(--line);border-radius:var(--r-md,6px);background:var(--white);box-shadow:var(--shadow-sm);overflow:hidden}
.trip-head{display:flex;align-items:baseline;gap:14px;padding:14px 18px;border-bottom:1px solid var(--line);background:var(--orange-soft);flex-wrap:wrap}
.trip-head .tn{font-family:var(--font-display);font-weight:800;font-size:22px;text-transform:uppercase;letter-spacing:.02em;color:var(--ink);line-height:1}
.trip-head .td{font-family:var(--font-mono);font-size:11px;color:var(--gold);letter-spacing:.12em}
.trip-head .tc{font-family:var(--font-mono);font-size:10px;color:var(--muted);letter-spacing:.15em;margin-left:auto;text-transform:uppercase}
.trip-group .card{margin-bottom:0;border:none;border-bottom:1px solid var(--line);border-radius:0;border-left:3px solid var(--line)}
.trip-group .card:last-child{border-bottom:none}
.card{display:grid;grid-template-columns:78px 1fr;gap:20px;padding:20px 22px;margin-bottom:12px;background:var(--card);border:1px solid var(--line);border-left:3px solid var(--gold-soft);border-radius:3px;transition:transform .2s,background .2s,border-color .2s}
.card:hover{background:var(--card-hi)}
.date-blk{text-align:center;border-right:1px solid var(--line);padding-right:18px}
.date-blk .mon{font-family:var(--font-mono);font-size:12px;letter-spacing:.18em;color:var(--gold)}
.date-blk .day{font-family:var(--font-display);font-weight:800;font-size:38px;line-height:.9;margin-top:2px}
.card .top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.place-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-width:0}
.place-name{font-family:var(--font-display);font-weight:800;font-size:28px;text-transform:uppercase;line-height:1;color:var(--ink)}
.place-loc{font-family:var(--font-display);font-weight:500;font-size:14px;color:var(--stone-600);margin-top:8px}
.place-loc .country{color:var(--gold);font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;margin-left:6px;text-transform:uppercase}
.meta{font-family:var(--font-mono);font-size:11px;color:var(--muted);letter-spacing:.06em;margin-top:4px}
.story{font-family:var(--font-editorial);font-style:italic;font-size:16px;line-height:1.6;color:var(--stone-700);border-left:2px solid var(--orange);padding:2px 0 2px 14px;margin-top:13px;max-width:62ch}
.tag-row{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.t-tag{font-family:var(--font-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:4px 9px;border:1px solid var(--line);color:var(--muted);border-radius:2px;cursor:pointer;transition:.15s;background:transparent}
.t-tag:hover{border-color:var(--gold);color:var(--gold)}
.with{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin-top:12px}
.with-label{font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;color:var(--muted);text-transform:uppercase;margin-right:3px}
.friend{display:inline-flex;align-items:center;gap:7px;padding:3px 11px 3px 3px;background:var(--white);border:1px solid var(--line);border-radius:20px;cursor:pointer;transition:.15s;font-family:var(--font-display);font-weight:600;font-size:12px;color:var(--stone-700)}
.friend:hover{border-color:var(--gold);color:var(--gold)}
.person-av{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;color:#fff;font-family:var(--font-display);font-weight:700;font-size:9px;letter-spacing:.4px;position:relative;overflow:hidden;flex-shrink:0;text-transform:uppercase;line-height:1}
.person-av.lg{width:32px;height:32px;font-size:13px}
.person-av img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
/* photo gallery */
.gallery{display:flex;gap:6px;margin-top:14px;flex-wrap:wrap}
.gthumb{position:relative;width:104px;height:78px;border-radius:var(--r-md,6px);overflow:hidden;background:var(--stone-100);border:1px solid var(--line);cursor:pointer;flex-shrink:0;transition:.18s}
.gthumb:hover{border-color:var(--orange);transform:translateY(-2px);box-shadow:var(--shadow-md)}
.gthumb img{width:100%;height:100%;object-fit:cover;display:block}
.gthumb .more{position:absolute;inset:0;background:rgba(0,0,0,.55);color:var(--gold);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;font-size:22px;letter-spacing:.02em}
/* snapshots strip (page-bottom, outside the map/timeline/stats tabs) */
.snapshots{margin-top:46px;padding-top:26px;border-top:1px solid var(--line)}
.snap-title{font-family:var(--font-display);font-weight:800;font-size:24px;letter-spacing:-.02em;color:var(--ink);margin-bottom:12px}
.snapshots .gallery .gthumb{padding:0;width:132px;height:99px}
/* lightbox */
#lightbox{position:fixed;inset:0;background:rgba(8,7,11,.92);display:none;align-items:center;justify-content:center;z-index:1500;backdrop-filter:blur(6px)}
#lightbox.show{display:flex}
#lightbox .lb-img{max-width:92vw;max-height:88vh;object-fit:contain;border:1px solid rgba(255,255,255,.14);border-radius:var(--r-md,6px);box-shadow:0 20px 60px rgba(0,0,0,.6)}
#lightbox .lb-btn{position:absolute;background:rgba(30,28,25,.85);border:1px solid rgba(255,255,255,.18);color:var(--paper);font-family:var(--font-mono);font-size:22px;width:44px;height:44px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s}
#lightbox .lb-btn:hover{border-color:var(--orange);color:var(--orange)}
#lightbox .lb-prev{left:22px;top:50%;transform:translateY(-50%)}
#lightbox .lb-next{right:22px;top:50%;transform:translateY(-50%)}
#lightbox .lb-close{right:22px;top:22px}
#lightbox .lb-cap{position:absolute;bottom:22px;left:50%;transform:translateX(-50%);font-family:var(--font-mono);font-size:11px;color:var(--stone-300);letter-spacing:.12em;background:rgba(30,28,25,.75);padding:7px 14px;border:1px solid rgba(255,255,255,.18);border-radius:var(--r-sm,4px)}
/* map */
.mapview{display:none;padding:24px 0 10px}
.mapview.show{display:block}
#map{height:600px;width:100%;border:1px solid var(--line);border-radius:var(--r-md,6px);background:var(--stone-100)}
.legend{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-top:14px;font-family:var(--font-mono);font-size:11px;color:var(--muted);letter-spacing:.06em}
.legend .it{display:flex;align-items:center;gap:7px}
.legend .sw{width:11px;height:11px;border-radius:50%;flex-shrink:0}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:var(--white);color:var(--stone-700);border:1px solid var(--line);box-shadow:var(--shadow-md)}
.leaflet-popup-content{margin:14px 16px;font-family:var(--font-display);max-width:280px}
.pp-v{font-family:var(--font-display);font-weight:700;font-size:18px;text-transform:uppercase;line-height:1}
.pp-m{font-family:var(--font-mono);font-size:10px;color:var(--gold);letter-spacing:.12em;margin:4px 0 9px}
.pp-s{font-size:13px;line-height:1.45;border-top:1px solid var(--line);padding-top:7px;margin-top:7px}
.pp-s b{color:var(--gold);font-family:var(--font-mono);font-size:10px;margin-right:6px;letter-spacing:.08em}
.leaflet-container a{color:var(--gold)}
/* stats */
.statsview{display:none;padding:30px 0 10px}
.statsview.show{display:block}
.panel{margin-bottom:44px}
.panel h3{font-family:var(--font-mono);font-size:12px;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);margin-bottom:18px;font-weight:700;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
.spanchart{display:flex;align-items:flex-end;gap:5px;height:210px;overflow-x:auto;padding-bottom:4px}
.col{flex:1;min-width:24px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;position:relative}
.col .bar{width:78%;background:var(--orange);border-radius:4px 4px 0 0;height:0;transition:height .8s cubic-bezier(.2,.8,.2,1);min-height:2px}
.col.zero .bar{background:var(--stone-200)}
.col .cnt{font-family:var(--font-mono);font-size:10px;color:var(--ink);margin-bottom:4px;opacity:0;transition:.3s}
.col:hover .cnt{opacity:1}
.col .yr{font-family:var(--font-mono);font-size:9px;color:var(--muted);margin-top:7px;writing-mode:vertical-rl;transform:rotate(180deg);letter-spacing:.05em}
.barrow{display:grid;grid-template-columns:140px 1fr 44px;align-items:center;gap:12px;margin-bottom:7px;font-family:var(--font-mono);font-size:12px}
.barrow .lab{color:var(--muted);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.barrow .track{height:18px;background:var(--stone-100);border-radius:4px;overflow:hidden}
.barrow .fill{height:100%;background:var(--orange);border-radius:4px;width:0;transition:width .9s cubic-bezier(.2,.8,.2,1)}
.barrow .v{color:var(--ink);font-weight:700}
.vrow{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:11px 0;border-bottom:1px solid var(--line);font-family:var(--font-display)}
.vrow .nm{font-weight:600;font-size:16px}
.vrow .nm .sm{font-family:var(--font-mono);font-size:10px;color:var(--muted);letter-spacing:.1em;margin-left:8px;text-transform:uppercase}
.vrow .ct{font-family:var(--font-mono);color:var(--gold);font-size:13px;flex-shrink:0}
.budgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px}
.budcard{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:9px 12px;background:var(--card);border:1px solid var(--line);border-radius:2px;cursor:pointer;transition:.15s}
.budcard:hover{border-color:var(--gold);background:var(--card-hi);transform:translateY(-2px)}
.budcard .an{font-family:var(--font-display);font-weight:600;font-size:15px;line-height:1.05}
.budcard .ay{font-family:var(--font-mono);font-size:9px;color:var(--muted);margin-top:2px}
.budcard .ac{font-family:var(--font-mono);font-size:12px;color:var(--gold);font-weight:700;flex-shrink:0}
.high-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.high{padding:18px;background:var(--card);border:1px solid var(--line);border-radius:3px}
.high .hl{font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;color:var(--muted);text-transform:uppercase}
.high .hn{font-family:var(--font-display);font-weight:800;font-size:24px;text-transform:uppercase;margin-top:6px;line-height:1.05;color:var(--ink)}
.high .hs{font-family:var(--font-mono);font-size:11px;color:var(--gold);letter-spacing:.1em;margin-top:5px}
footer{border-top:1px solid var(--line);margin-top:40px;padding:30px 0 60px;font-family:var(--font-mono);font-size:11px;color:var(--muted);letter-spacing:.08em}
.empty{text-align:center;padding:70px 0;font-family:var(--font-mono);color:var(--muted)}
@media(max-width:640px){
  .stats{grid-template-columns:repeat(3,1fr)}
  .stat:nth-child(4),.stat:nth-child(5){border-top:1px solid var(--line)}
  .card{grid-template-columns:60px 1fr;gap:14px;padding:16px}
  .date-blk{padding-right:12px} .date-blk .day{font-size:30px}
  .place-name{font-size:22px}
  .gthumb{width:88px;height:66px}
  #map{height:460px}
  .barrow{grid-template-columns:96px 1fr 44px}
  .trip-head{padding:12px 14px}
  .trip-head .tn{font-size:18px}
  #lightbox .lb-prev{left:8px} #lightbox .lb-next{right:8px}
  #lightbox .lb-btn{width:38px;height:38px;font-size:18px}
}
</style>
</head>
<body>
<div class="marquee"><span id="mq"></span></div>
<div class="wrap">
  <a href="/" class="homelink">&larr; Julian Fife</a>
  <header class="hero">
    <div class="kicker" id="kicker">A travel log</div>
    <h1>Places</h1>
    <p class="sub">Every trip, every destination. National parks, foreign cities, scenic detours. Mapped, timelined, and remembered.</p>
  </header>
</div>
<div class="wrap"><div class="stats" id="statstrip"></div></div>
<div class="controls"><div class="wrap">
  <div class="row">
    <div class="search"><input id="q" type="text" placeholder="Search places, countries, friends, tags…" autocomplete="off"><button class="clearq" id="clearQ" type="button" aria-label="Clear search">×</button></div>
    <div class="chips" id="countryChips"></div>
    <div class="chips" id="tagChips"></div>
    <button class="chip" id="orderBtn">▼ Newest</button>
    <div class="tabs">
      <button class="tab on" data-view="map">Map</button>
      <button class="tab" data-view="timeline">Timeline</button>
      <button class="tab" data-view="stats">Stats</button>
    </div>
  </div>
  <div class="countline" id="countline"></div>
</div></div>
<div class="wrap">
  <section class="mapview show" id="mapview"><div id="map"></div>
    <div class="legend" id="mapLegend">
      <div class="it"><span class="sw" style="background:#BF5700"></span>North America</div>
      <div class="it"><span class="sw" style="background:#009184"></span>Europe</div>
      <div class="it"><span class="sw" style="background:#6257C4"></span>Caribbean</div>
      <div class="it"><span class="sw" style="background:#A32D5E"></span>Central America</div>
      <div id="legendNote" style="margin-left:auto">○ marker size = visits · click for trips</div>
    </div>
  </section>
  <main class="timeline" id="timeline"></main>
  <section class="statsview" id="statsview"></section>
  {tripPhotos.length > 0 && (
    <section class="snapshots">
      <h2 class="snap-title">Snapshots</h2>
      <div class="gallery" id="snapStrip">
        {tripPhotos.map(src => (
          <button class="gthumb" type="button" data-full={src} aria-label="View photo">
            <img src={src} alt="" loading="lazy" />
          </button>
        ))}
      </div>
    </section>
  )}
  <footer id="foot"></footer>
</div>
<div id="lightbox" role="dialog" aria-label="Photo viewer">
  <button class="lb-btn lb-close" id="lbClose" aria-label="Close">✕</button>
  <button class="lb-btn lb-prev" id="lbPrev" aria-label="Previous">‹</button>
  <img class="lb-img" id="lbImg" alt="">
  <button class="lb-btn lb-next" id="lbNext" aria-label="Next">›</button>
  <div class="lb-cap" id="lbCap"></div>
</div>
<script is:inline>
/* Built-in fallback list — empty by design. The Google Sheet is the source of
   truth (see SHEET_CSV_URL below). On the rare case where the sheet is
   unreachable AND no localStorage cache exists yet (e.g. brand-new visitor on
   a flaky network), the page shows "No trips logged yet" rather than fake
   data. Don't seed examples here. */
let DATA = [];

/* Map of countries the page has rendered, keyed by lowercase name → ISO-ish display.
   No baked geocoding table: lat/lng comes from the sheet (per row) so adding a new
   destination never needs a code edit. */

/* ---- LIVE DATA (Google Sheet) ----
   Paste your sheet's "Publish to web → CSV" link below. Leave it as "" to use
   the built-in fallback list above.
   Sheet columns (header row, any order):
     date_start | date_end | trip_id | trip_name | place | region | country | lat | lng | friends | photo_folder | photos | story | tags
     · date_start    YYYY-MM-DD  (required)
     · date_end      YYYY-MM-DD  (optional; defaults to date_start for single-day visits)
     · trip_id       optional kebab-case slug. Rows sharing a trip_id are grouped
                     as one multi-stop trip on the timeline (e.g. "europe-2024").
     · trip_name     optional display name for the grouped trip (e.g. "Europe · Spring 2024").
     · place         destination name (e.g. "Paris", "Yellowstone National Park").
     · region        subdivision — US state abbr (e.g. "WY") or international region/province.
     · country       full country name (e.g. "United States", "France").
     · lat, lng      decimal degrees. Right-click in Google Maps → "What's here?" to copy.
     · friends       semicolons separate names. Photos live at people/<slug>.jpg;
                     friends without a photo show a colored initials circle.
     · photo_folder  optional subfolder name under trips/. Defaults to slug(trip_id || place + year).
     · photos        semicolons separate filenames inside trips/<photo_folder>/ (e.g. "01.jpg;02.jpg").
     · story         free-text paragraph; renders italicized on the card.
     · tags          semicolons separate free-form tags (e.g. "national-park;hiking;family").
*/
const SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vTaYaD031CsA8keUhvPWwot0J07gbJ6PIseiehSiODGdHP1l6ZeoeKa9V-V_ExuLo--06gNnMsmfb7T/pub?output=csv";

const _MONS=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
const _MONL=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

function slugify(s){return (s||'').toLowerCase().replace(/['']/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');}
function _initials(name){return (name||'').split(/\s+/).filter(Boolean).map(w=>w[0]||'').join('').slice(0,2).toUpperCase();}

/* ---- Categorical colour: continent, not country ----
   Twenty countries cannot be told apart by hue, so markers, chips and bars all
   colour by continent instead — four slots from the brand's validated ramp
   (worst all-pairs CVD deltaE 14.4 on paper; every slot clears 3:1 contrast).
   Colour follows the entity, never its rank: filtering never repaints a
   survivor. A country with no continent falls back to neutral 'Other' rather
   than a generated hue. Add new countries here as the sheet grows. */
const CONTINENT={
  'United States':'North America','Mexico':'North America',
  'France':'Europe','Italy':'Europe','Greece':'Europe','Germany':'Europe',
  'England':'Europe','Netherlands':'Europe','Scotland':'Europe','Austria':'Europe',
  'Czech Republic':'Europe','Belgium':'Europe','Spain':'Europe','Ireland':'Europe',
  'Vatican City':'Europe',
  'Cayman Islands':'Caribbean','Jamaica':'Caribbean',
  'Dominican Republic':'Caribbean','Bahamas':'Caribbean',
  'Panama':'Central America',
};
const CONT_COLOR={'North America':'#BF5700','Europe':'#009184','Caribbean':'#6257C4','Central America':'#A32D5E'};
const CONT_ORDER=['North America','Europe','Caribbean','Central America'];
const OTHER='#9C968A';
const continentOf=(country)=>CONTINENT[country]||'Other';
const continentColor=(country)=>CONT_COLOR[continentOf(country)]||OTHER;
/* Identity tint for a person's initials circle when they have no photo.
   Not a data encoding — it must not use the categorical series ramp. */
function _colorFor(name){let h=0;for(let i=0;i<(name||'').length;i++)h=((h<<5)-h+name.charCodeAt(i))|0;
  return `hsl(${Math.abs(h)%360},42%,38%)`;}
function _personPhotoFallback(img){const tries=['png','webp'];img.__t=img.__t||0;
  if(img.__t<tries.length){img.src=img.src.replace(/\.[a-z]+$/i,'.'+tries[img.__t++]);}else{img.remove();}}
function personAvatarHtml(name,extraCls){
  const slug=slugify(name),initials=_initials(name),bg=_colorFor(name);
  return `<span class="person-av${extraCls?' '+extraCls:''}" style="background:${bg}">${initials}<img src="/people/${slug}.jpg" alt="" loading="lazy" onerror="_personPhotoFallback(this)"></span>`;}

function _parseDate(s){const p=(s||'').split('-').map(Number);return {y:p[0],m:p[1],d:p[2]};}
function _formatRange(a,b){
  // "Jul 4, 2024" (single day) | "Jul 4 – 12, 2024" (same month) |
  // "Jul 28 – Aug 3, 2024" (cross-month, same year) |
  // "Dec 30, 2023 – Jan 5, 2024" (cross-year)
  if(!a)return '';
  if(!b||a===b){const p=_parseDate(a);return `${_MONL[p.m-1]} ${p.d}, ${p.y}`;}
  const A=_parseDate(a),B=_parseDate(b);
  if(A.y!==B.y)return `${_MONL[A.m-1]} ${A.d}, ${A.y} – ${_MONL[B.m-1]} ${B.d}, ${B.y}`;
  if(A.m!==B.m)return `${_MONL[A.m-1]} ${A.d} – ${_MONL[B.m-1]} ${B.d}, ${A.y}`;
  return `${_MONL[A.m-1]} ${A.d}–${B.d}, ${A.y}`;
}
function _photoFolder(r){return r.photo_folder||slugify((r.trip_id||r.place||'')+'-'+(r.date_start||'').slice(0,4));}
function _spanDays(a,b){if(!a)return 0;const A=new Date(a),B=new Date(b||a);return Math.max(1,Math.round((B-A)/86400000)+1);}

function deriveTrip(r){
  const p=_parseDate(r.date_start);
  return {...r,
    date:r.date_start,year:p.y,mon:_MONS[p.m-1],day:String(p.d),
    range:_formatRange(r.date_start,r.date_end||r.date_start),
    span:_spanDays(r.date_start,r.date_end||r.date_start),
    photo_folder:_photoFolder(r),
    photos:r.photos||[],friends:r.friends||[],tags:r.tags||[],
    lat:(r.lat===''||r.lat==null)?NaN:Number(r.lat),
    lng:(r.lng===''||r.lng==null)?NaN:Number(r.lng)};
}

function parseCSV(text){const rows=[];let row=[],f='',i=0,q=false;text=text.replace(/\r\n?/g,'\n');
  while(i<text.length){const c=text[i];
    if(q){if(c==='"'){if(text[i+1]==='"'){f+='"';i+=2;continue;}q=false;i++;continue;}f+=c;i++;continue;}
    if(c==='"'){q=true;i++;continue;}
    if(c===','){row.push(f);f='';i++;continue;}
    if(c==='\n'){row.push(f);rows.push(row);row=[];f='';i++;continue;}
    f+=c;i++;}
  if(f.length||row.length){row.push(f);rows.push(row);}
  return rows;}
function rowsToTrips(rows){if(!rows.length)return [];
  const head=rows[0].map(h=>h.trim().toLowerCase()),at=n=>head.indexOf(n);
  const ds=at('date_start'),de=at('date_end'),ti=at('trip_id'),tn=at('trip_name'),
        pl=at('place'),rg=at('region'),co=at('country'),la=at('lat'),lg=at('lng'),
        fr=at('friends'),pf=at('photo_folder'),ph=at('photos'),st=at('story'),tg=at('tags');
  if(ds<0||pl<0)return [];
  const splitList=v=>(v||'').split(';').map(x=>x.trim()).filter(Boolean);
  const out=[];
  for(let r=1;r<rows.length;r++){const c=rows[r],date_start=(c[ds]||'').trim();if(!date_start)continue;
    out.push(deriveTrip({
      date_start,
      date_end:(c[de]||'').trim()||date_start,
      trip_id:(c[ti]||'').trim(),
      trip_name:(c[tn]||'').trim(),
      place:(c[pl]||'').trim(),
      region:(c[rg]||'').trim(),
      country:(c[co]||'').trim(),
      lat:(c[la]||'').trim(),
      lng:(c[lg]||'').trim(),
      friends:splitList(c[fr]),
      photo_folder:(c[pf]||'').trim(),
      photos:splitList(c[ph]),
      story:(c[st]||'').trim(),
      tags:splitList(c[tg])
    }));}
  return out;}

const _TRIPS_CACHE_KEY='tl_trips_v1', _TRIPS_CACHE_TTL=30*24*3600*1000;
async function loadTrips(){
  if(!SHEET_CSV_URL)return null;
  try{
    const res=await fetch(SHEET_CSV_URL,{cache:'no-store'});
    if(!res.ok)throw new Error('HTTP '+res.status);
    const trips=rowsToTrips(parseCSV(await res.text()));
    if(trips&&trips.length){try{localStorage.setItem(_TRIPS_CACHE_KEY,JSON.stringify({t:Date.now(),trips}));}catch(_){}}
    return trips;
  }catch(e){
    try{const cached=JSON.parse(localStorage.getItem(_TRIPS_CACHE_KEY)||'null');
      if(cached&&cached.trips&&cached.trips.length&&(Date.now()-cached.t)<_TRIPS_CACHE_TTL){
        console.warn('Travel sheet unreachable; using cached trips from',new Date(cached.t).toISOString());
        return cached.trips;
      }
    }catch(_){}
    throw e;
  }
}

/* ---- STATE ---- */
let order="desc",view="map";
const filt={q:"",country:"ALL",tag:"ALL"};
let yrsAll=[];

/* ---- TRIP GROUPING ----
   Rows sharing a trip_id collapse into one trip with multiple stops.
   Rows without a trip_id are treated as solo (1-stop) trips. */
function tripGroups(rows){
  const g={};
  rows.forEach(r=>{
    const key = r.trip_id ? 'id:'+r.trip_id : 'solo:'+r.date_start+':'+slugify(r.place);
    if(!g[key]) g[key]={id:r.trip_id,name:r.trip_name,stops:[]};
    g[key].stops.push(r);
  });
  return Object.values(g).map(t=>{
    t.stops.sort((a,b)=>a.date_start.localeCompare(b.date_start));
    t.min=t.stops[0].date_start;
    t.max=t.stops[t.stops.length-1].date_end||t.stops[t.stops.length-1].date_start;
    t.year=+t.min.slice(0,4);
    t.range=_formatRange(t.min,t.max);
    t.span=_spanDays(t.min,t.max);
    if(!t.name && t.id) t.name=t.stops.map(s=>s.place).join(' · ');
    return t;
  });
}

function match(r){
  if(filt.country!=="ALL"&&r.country!==filt.country)return false;
  if(filt.tag!=="ALL"&&!(r.tags||[]).includes(filt.tag))return false;
  if(filt.q){const h=(r.place+' '+r.country+' '+(r.region||'')+' '+(r.trip_name||'')+' '+(r.story||'')+' '+(r.friends||[]).join(' ')+' '+(r.tags||[]).join(' ')).toLowerCase();
    if(!h.includes(filt.q))return false;}
  return true;
}
function filtered(){return DATA.filter(match);}

function refresh(){renderTimeline(); if(view==="map")renderMap(); if(view==="stats")buildStats();}

/* ---- BOOT ---- */
function boot(){
  // Normalize: rows from the live CSV are already passed through deriveTrip();
  // rows from the baked-in literal aren't, so re-derive any missing fields.
  DATA = DATA.map(r => r && typeof r.year === 'number' ? r : deriveTrip(r));
  yrsAll=DATA.map(r=>r.year);
  // Marquee — scroll a sample of place names
  const places=[...new Set(DATA.map(r=>r.place))];
  document.getElementById('mq').innerHTML=places.length?(places.join('  <b>◉</b>  ')+'  <b>◉</b>  ').repeat(2):'';
  // Hero kicker year range
  const minY=yrsAll.length?Math.min(...yrsAll):0, maxY=yrsAll.length?Math.max(...yrsAll):0;
  document.getElementById('kicker').textContent=yrsAll.length?`A travel log · ${minY} – ${maxY}`:'A travel log · coming soon';
  // Stats strip
  const groups=tripGroups(DATA);
  const nTrips=groups.length, nDest=DATA.length,
        nCountries=new Set(DATA.map(r=>r.country)).size,
        nRegions=new Set(DATA.map(r=>(r.country==='United States'?r.region:r.country))).size,
        span=Math.max(0,maxY-minY);
  document.getElementById('statstrip').innerHTML=
    [["Trips",nTrips],["Destinations",nDest],["Countries",nCountries],["Regions",nRegions],["Years",span]]
    .map(([l,n])=>`<div class="stat"><div class="n" data-to="${n}">0</div><div class="l">${l}</div></div>`).join('');
  countUp();
  // Country chips — sorted by visit count desc
  const ctc={}; DATA.forEach(r=>ctc[r.country]=(ctc[r.country]||0)+1);
  const ctSorted=Object.keys(ctc).sort((a,b)=>ctc[b]-ctc[a]||a.localeCompare(b));
  document.getElementById('countryChips').innerHTML=`<button class="chip on" data-co="ALL">All</button>`+
    ctSorted.map(c=>`<button class="chip dot" data-co="${c.replace(/"/g,'&quot;')}" style="color:${continentColor(c)}">${c}</button>`).join('');
  document.querySelectorAll('#countryChips .chip').forEach(c=>c.onclick=()=>{filt.country=c.dataset.co;
    document.querySelectorAll('#countryChips .chip').forEach(x=>x.classList.toggle('on',x===c));refresh();});
  // Tag chips — top tags
  const tgc={}; DATA.forEach(r=>(r.tags||[]).forEach(t=>tgc[t]=(tgc[t]||0)+1));
  const tgSorted=Object.keys(tgc).sort((a,b)=>tgc[b]-tgc[a]||a.localeCompare(b));
  document.getElementById('tagChips').innerHTML=tgSorted.length?(`<button class="chip on" data-tg="ALL">All Tags</button>`+
    tgSorted.map(t=>`<button class="chip" data-tg="${t.replace(/"/g,'&quot;')}">${t.replace(/-/g,' ')}</button>`).join('')):'';
  document.querySelectorAll('#tagChips .chip').forEach(c=>c.onclick=()=>{filt.tag=c.dataset.tg;
    document.querySelectorAll('#tagChips .chip').forEach(x=>x.classList.toggle('on',x===c));refresh();});
  // Footer
  const yRange=yrsAll.length?`${minY}–${maxY}`:'';
  document.getElementById('foot').innerHTML = nDest
    ? `${nTrips} trips · ${nDest} destinations · ${nCountries} countries${yRange?' · '+yRange:''}. ◉`
    : `No trips logged yet. Add rows to your sheet to populate this page.`;
  // Initial render: map is default
  refresh();
}
function countUp(){document.querySelectorAll('.stat .n').forEach(el=>{const to=+el.dataset.to;let c=0;const st=Math.max(1,Math.round(to/40));
  const t=setInterval(()=>{c+=st;if(c>=to){c=to;clearInterval(t)}el.textContent=c;},22);});}

/* Search clear button. Kept in sync with programmatic writes to #q (pickArtist,
   pickFriend, pickTag, Escape) — those set .value directly and fire no input event. */
function _syncClear(){const q=document.getElementById('q'),c=document.getElementById('clearQ');
  if(q&&c)c.classList.toggle('show',!!q.value);}
function _clearSearch(){const q=document.getElementById('q');if(!q)return;
  q.value='';filt.q='';_syncClear();refresh();q.focus();}
document.getElementById('q').oninput=e=>{filt.q=e.target.value.toLowerCase();_syncClear();refresh();};
document.getElementById('clearQ').onclick=_clearSearch;
document.getElementById('orderBtn').onclick=function(){order=order==="desc"?"asc":"desc";
  this.textContent=order==="desc"?"▼ Newest":"▲ Oldest";renderTimeline();};
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>setView(t.dataset.view));

function setView(v){view=v;
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.view===v));
  document.getElementById('timeline').classList.toggle('show',v==="timeline");
  document.getElementById('mapview').classList.toggle('show',v==="map");
  document.getElementById('statsview').classList.toggle('show',v==="stats");
  document.getElementById('orderBtn').style.visibility=v==="timeline"?"visible":"hidden";
  if(v==="map")renderMap();
  if(v==="stats")buildStats();
}

/* ---- TIMELINE ---- */
function _galleryHtml(r){
  if(!r.photos||!r.photos.length)return '';
  const folder=r.photo_folder, paths=r.photos.map(p=>/^https?:\/\//i.test(p)?p:`/trips/${folder}/${p}`);
  const MAX=5, shown=paths.slice(0,MAX), extra=paths.length-MAX;
  const pj=JSON.stringify(paths).replace(/"/g,'&quot;');
  return `<div class="gallery" data-photos="${pj}" data-cap="${(r.place||'').replace(/"/g,'&quot;')}">`+
    shown.map((p,i)=>{
      const more = (i===MAX-1 && extra>0) ? `<div class="more">+${extra}</div>` : '';
      return `<div class="gthumb" data-i="${i}"><img src="${p}" alt="" loading="lazy" onerror="this.parentNode.style.display='none'">${more}</div>`;
    }).join('')+
    `</div>`;
}
function _stopCardHtml(r,opts){
  const fr=r.friends||[];
  const withRow=fr.length?`<div class="with"><span class="with-label">With</span>${fr.map(f=>`<span class="friend" data-friend="${f.replace(/"/g,'&quot;')}" onclick="pickFriend('${f.replace(/'/g,"\\'")}')">${personAvatarHtml(f)}<span>${f}</span></span>`).join('')}</div>`:'';
  const tagsRow=(r.tags||[]).length?`<div class="tag-row">${r.tags.map(t=>`<button class="t-tag" data-tg="${t.replace(/"/g,'&quot;')}" onclick="pickTag('${t.replace(/'/g,"\\'")}')">${t.replace(/-/g,' ')}</button>`).join('')}</div>`:'';
  const story=r.story?`<div class="story">${r.story.replace(/</g,'&lt;')}</div>`:'';
  const locLine = [r.region, r.country].filter(Boolean);
  const loc = `<div class="place-loc">${r.region?r.region+' · ':''}<span class="country">${r.country||''}</span></div>`;
  const rangeMeta = `${r.range}${r.span>1?` · ${r.span} days`:''}`;
  return `<div class="card" data-place="${(r.place||'').replace(/"/g,'&quot;')}">
    <div class="date-blk"><div class="mon">${r.mon}</div><div class="day">${r.day}</div></div>
    <div><div class="top"><div class="place-head"><span class="place-name">${r.place}</span></div></div>
    ${loc}
    <div class="meta">${rangeMeta}</div>
    ${story}
    ${_galleryHtml(r)}
    ${tagsRow}
    ${withRow}</div></div>`;
}
function _tripGroupHtml(t){
  // multi-stop trip wrapped in a group card; single-stop renders as a plain card
  if(t.stops.length===1) return _stopCardHtml(t.stops[0]);
  const head=`<div class="trip-head"><div class="tn">${t.name||'Trip'}</div><div class="td">${t.range}</div><div class="tc">${t.stops.length} stops · ${t.span} days</div></div>`;
  return `<div class="trip-group">${head}${t.stops.map(s=>_stopCardHtml(s)).join('')}</div>`;
}
function renderTimeline(){
  const rows=filtered();
  const trips=tripGroups(rows).sort((a,b)=>order==="desc"?b.min.localeCompare(a.min):a.min.localeCompare(b.min));
  document.getElementById('countline').innerHTML=`Showing <b>${trips.length}</b> trip${trips.length===1?'':'s'} · <b>${rows.length}</b> destination${rows.length===1?'':'s'}`;
  const tl=document.getElementById('timeline');
  if(!trips.length){
    tl.innerHTML=DATA.length
      ? `<div class="empty">No trips match that. Try clearing the search (Esc).</div>`
      : `<div class="empty">No trips logged yet.<br><span style="opacity:.6">Add rows to your sheet to populate this page.</span></div>`;
    return;}
  const byYear={}; trips.forEach(t=>{(byYear[t.year]=byYear[t.year]||[]).push(t);});
  const years=Object.keys(byYear).sort((a,b)=>order==="desc"?b-a:a-b);
  tl.innerHTML=years.map(y=>{const ts=byYear[y];
    return `<div class="year-block"><div class="year-head"><div class="y">${y}</div><div class="bar"></div><div class="ct">${ts.length} trip${ts.length===1?'':'s'}</div></div>`+
      ts.map(_tripGroupHtml).join('')+`</div>`;}).join('');
  // Wire galleries to the lightbox
  tl.querySelectorAll('.gallery').forEach(g=>{
    const paths=JSON.parse(g.dataset.photos);
    const cap=g.dataset.cap;
    g.querySelectorAll('.gthumb').forEach((th,i)=>th.onclick=()=>openLightbox(paths,i,cap));
  });
}
function pickFriend(name){filt.q=name.toLowerCase();document.getElementById('q').value=name;_syncClear();
  filt.country="ALL";filt.tag="ALL";
  document.querySelectorAll('#countryChips .chip').forEach(x=>x.classList.toggle('on',x.dataset.co==="ALL"));
  document.querySelectorAll('#tagChips .chip').forEach(x=>x.classList.toggle('on',x.dataset.tg==="ALL"));
  setView('timeline');refresh();window.scrollTo({top:document.querySelector('.controls').offsetTop,behavior:'smooth'});}
function pickTag(t){filt.tag=t;filt.country="ALL";filt.q="";document.getElementById('q').value="";_syncClear();
  document.querySelectorAll('#countryChips .chip').forEach(x=>x.classList.toggle('on',x.dataset.co==="ALL"));
  document.querySelectorAll('#tagChips .chip').forEach(x=>x.classList.toggle('on',x.dataset.tg===t));
  setView('timeline');refresh();window.scrollTo({top:document.querySelector('.controls').offsetTop,behavior:'smooth'});}

/* ---- MAP ---- */
let map,markerLayer;
function renderMap(){
  if(typeof L==="undefined"){setTimeout(renderMap,200);return;}
  if(!map){
    map=L.map('map',{scrollWheelZoom:false,attributionControl:true,worldCopyJump:true}).setView([30,0],2);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
      {attribution:'© OpenStreetMap, © CARTO',subdomains:'abcd',maxZoom:19,noWrap:false}).addTo(map);
    markerLayer=L.layerGroup().addTo(map);
  }
  markerLayer.clearLayers();
  const rows=filtered().filter(r=>!isNaN(r.lat)&&!isNaN(r.lng));
  // Aggregate by place+country (same place name in two countries gets two markers)
  const agg={};
  rows.forEach(r=>{const k=r.place+'|'+r.country;
    const v=agg[k]=agg[k]||{n:0,place:r.place,country:r.country,region:r.region,lat:r.lat,lng:r.lng,visits:[]};
    v.n++;v.visits.push(r);});
  const pts=[];
  Object.values(agg).forEach(v=>{
    pts.push([v.lat,v.lng]);
    const r=6+Math.sqrt(v.n)*4.2;
    const color=continentColor(v.country);
    // 2px paper ring separates overlapping markers on the light basemap.
    const m=L.circleMarker([v.lat,v.lng],{radius:r,color:'#F6F4EF',weight:2,opacity:.95,fillColor:color,fillOpacity:.85});
    m.bindTooltip(`${v.place} · ${v.n}`,{direction:'top',className:'lf-tt'});
    const list=v.visits.slice().sort((a,b)=>b.date_start.localeCompare(a.date_start)).map(s=>
      `<div class="pp-s"><b>${_formatRange(s.date_start,s.date_end||s.date_start)}</b>${s.trip_name||s.story?.slice(0,80)||''}</div>`).join('');
    m.bindPopup(`<div class="pp-v">${v.place}</div><div class="pp-m">${v.region?v.region+' · ':''}${v.country} · ${v.n} VISIT${v.n>1?'S':''}</div>${list}`,{maxWidth:320});
    markerLayer.addLayer(m);
  });
  setTimeout(()=>{map.invalidateSize();
    if(pts.length===1)map.setView(pts[0],5);
    else if(pts.length>1)map.fitBounds(pts,{padding:[40,40],maxZoom:6});
  },80);
}

/* ---- STATS ---- */
function buildStats(){
  const rows=filtered();
  if(!yrsAll.length){document.getElementById('statsview').innerHTML='<div class="empty">No data yet.</div>';return;}
  const minY=Math.min(...yrsAll),maxY=Math.max(...yrsAll);
  const groups=tripGroups(rows);
  // Trips per year
  const yr={}; for(let y=minY;y<=maxY;y++)yr[y]=0;
  groups.forEach(t=>yr[t.year]=(yr[t.year]||0)+1);
  const mx=Math.max(1,...Object.values(yr));
  const cols=Object.keys(yr).map(y=>`<div class="col ${yr[y]===0?'zero':''}"><div class="cnt">${yr[y]}</div><div class="bar" data-h="${yr[y]/mx*100}"></div><div class="yr">'${String(y).slice(2)}</div></div>`).join('');
  // Top destinations (by visit count)
  const dst={}; rows.forEach(r=>{const k=r.place+'|'+r.country;
    const v=dst[k]=dst[k]||{n:0,place:r.place,country:r.country,region:r.region};v.n++;});
  const topD=Object.values(dst).sort((a,b)=>b.n-a.n||a.place.localeCompare(b.place)).slice(0,10)
    .map(v=>`<div class="vrow"><div class="nm">${v.place}<span class="sm">${v.region?v.region+' · ':''}${v.country}</span></div><div class="ct">${v.n} visit${v.n>1?'s':''}</div></div>`).join('');
  // By country
  const cc={}; rows.forEach(r=>cc[r.country]=(cc[r.country]||0)+1);
  const ccmx=Math.max(1,...Object.values(cc));
  const ccBars=Object.entries(cc).sort((a,b)=>b[1]-a[1]).map(([c,n])=>
    `<div class="barrow"><div class="lab">${c}</div><div class="track"><div class="fill" data-w="${n/ccmx*100}" style="background:${continentColor(c)}"></div></div><div class="v">${n}</div></div>`).join('');
  // By region (US states broken out; non-US countries collapsed)
  const reg={}; rows.forEach(r=>{
    const k=r.country==='United States'?(r.region||'(US)'):r.country;
    reg[k]=(reg[k]||0)+1;});
  const rgmx=Math.max(1,...Object.values(reg));
  const rgBars=Object.entries(reg).sort((a,b)=>b[1]-a[1]).slice(0,18).map(([s,n])=>
    `<div class="barrow"><div class="lab">${s}</div><div class="track"><div class="fill" data-w="${n/rgmx*100}"></div></div><div class="v">${n}</div></div>`).join('');
  // Travel companions (friends)
  const fm={}; rows.forEach(r=>(r.friends||[]).forEach(f=>{const o=fm[f]=fm[f]||{n:0,ys:new Set()};o.n++;o.ys.add(r.year);}));
  const buds=Object.entries(fm).map(([f,o])=>({f,n:o.n,min:Math.min(...o.ys),max:Math.max(...o.ys)}))
    .sort((a,b)=>b.n-a.n||a.f.localeCompare(b.f));
  const budHtml=buds.map(o=>`<div class="budcard" data-friend="${o.f.replace(/"/g,'&quot;')}" onclick="pickFriend('${o.f.replace(/'/g,"\\'")}')">
    ${personAvatarHtml(o.f,'lg')}<div><div class="an">${o.f}</div><div class="ay">${o.min===o.max?o.min:o.min+'–'+o.max}</div></div>
    <div class="ac">${o.n>1?'×'+o.n:'•'}</div></div>`).join('');
  // Highlights: first / most recent / longest — all derived from the filtered
  // `rows` (and `groups`, which already comes from `rows`) so that toggling a
  // country/tag/search updates every panel consistently. Using full DATA here
  // for first+last would make the highlights describe trips that aren't in any
  // other panel on the same screen.
  const rowsSorted=[...rows].sort((a,b)=>a.date_start.localeCompare(b.date_start));
  const first=rowsSorted[0], last=rowsSorted[rowsSorted.length-1];
  const longest=[...groups].sort((a,b)=>b.span-a.span)[0];
  const highHtml=`
    <div class="high"><div class="hl">First trip</div><div class="hn">${first?first.place:'none yet'}</div><div class="hs">${first?_formatRange(first.date_start,first.date_end||first.date_start):''}</div></div>
    <div class="high"><div class="hl">Most recent</div><div class="hn">${last?last.place:'none yet'}</div><div class="hs">${last?_formatRange(last.date_start,last.date_end||last.date_start):''}</div></div>
    <div class="high"><div class="hl">Longest trip</div><div class="hn">${longest?(longest.name||longest.stops[0].place):'none yet'}</div><div class="hs">${longest?longest.span+' days · '+longest.range:''}</div></div>`;
  document.getElementById('statsview').innerHTML=`
    <div class="panel"><h3>Highlights</h3><div class="high-row">${highHtml}</div></div>
    <div class="panel"><h3>Trips across the span · ${minY}–${maxY}</h3><div class="spanchart">${cols}</div></div>
    <div class="panel"><h3>Most-visited destinations</h3>${topD||'<div class="empty">No data.</div>'}</div>
    <div class="panel"><h3>By country</h3>${ccBars||'<div class="empty">No data.</div>'}</div>
    <div class="panel"><h3>By region <span style="font-weight:400;color:var(--muted);text-transform:none;letter-spacing:.04em">· US states broken out</span></h3>${rgBars||'<div class="empty">No data.</div>'}</div>
    ${buds.length?`<div class="panel"><h3>Travel companions · ${buds.length}</h3><div class="budgrid">${budHtml}</div></div>`:''}`;
  requestAnimationFrame(()=>setTimeout(()=>{
    document.querySelectorAll('.spanchart .bar').forEach(b=>b.style.height=b.dataset.h+'%');
    document.querySelectorAll('.barrow .fill').forEach(f=>f.style.width=f.dataset.w+'%');
  },60));
}

/* ---- LIGHTBOX ---- */
const lb={paths:[],i:0,cap:''};
function openLightbox(paths,i,cap){lb.paths=paths;lb.i=i;lb.cap=cap||'';_lbRender();
  document.getElementById('lightbox').classList.add('show');document.body.style.overflow='hidden';}
function closeLightbox(){document.getElementById('lightbox').classList.remove('show');document.body.style.overflow='';}
function _lbRender(){const img=document.getElementById('lbImg');img.src=lb.paths[lb.i];
  document.getElementById('lbCap').textContent=`${lb.cap?lb.cap+' · ':''}${lb.i+1} / ${lb.paths.length}`;}
function _lbStep(d){if(!lb.paths.length)return;lb.i=(lb.i+d+lb.paths.length)%lb.paths.length;_lbRender();}
document.getElementById('lbClose').onclick=closeLightbox;
document.getElementById('lbPrev').onclick=()=>_lbStep(-1);
document.getElementById('lbNext').onclick=()=>_lbStep(1);
document.getElementById('lightbox').addEventListener('click',e=>{if(e.target.id==='lightbox')closeLightbox();});
document.addEventListener('keydown',e=>{
  const lbOpen=document.getElementById('lightbox').classList.contains('show');
  if(lbOpen){
    if(e.key==='Escape')closeLightbox();
    else if(e.key==='ArrowRight')_lbStep(1);
    else if(e.key==='ArrowLeft')_lbStep(-1);
    return;
  }
  if(e.key==='Escape'){document.getElementById('q').value='';filt.q='';_syncClear();refresh();}
});

/* ---- INIT ---- */
(async()=>{
  document.getElementById('timeline').innerHTML='<div class="empty">Loading trips…</div>';
  try{
    const rows=await loadTrips();
    if(rows&&rows.length)DATA=rows;
    else if(rows)console.warn('Travel sheet loaded but had no rows; using built-in list.');
  }catch(e){console.warn('Travel sheet load failed; using built-in list.',e);}
  boot();
})();

/* Snapshots strip — server-rendered above, so it needs no sheet data. Reuses
   the per-trip lightbox rather than shipping a second one. */
(function(){
  const strip=document.getElementById('snapStrip');
  if(!strip)return;
  const thumbs=[...strip.querySelectorAll('.gthumb')];
  const paths=thumbs.map(t=>t.dataset.full);
  thumbs.forEach((t,i)=>t.onclick=()=>openLightbox(paths,i,'Snapshots'));
})();
</script>
